#include <stdio.h>
#include <string.h>

char* firstPalindrome(char** words, int wordsSize)
{
    for (int i = 0; i < wordsSize; i++) 
{
        char *word = words[i];
        int len = strlen(word);
        int isPalindrome = 1;

        for (int j = 0; j < len / 2; j++) {
            if (word[j] != word[len - 1 - j])
{
                isPalindrome = 0;

                break;
            }
        }

       
        if (isPalindrome)
{
            return word;
        }
    }

    return "";
}
